{
  "manifest_version": 3,
  "name": "RAG Search",
  "version": "1.0.0",
  "description": "Index any page and search your personal knowledge base.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8108/*"
  ]
}
